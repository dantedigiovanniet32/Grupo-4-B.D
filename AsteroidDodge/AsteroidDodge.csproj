<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AsteroidDodge</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="assets\spritesheet.png" CopyToOutputDirectory="PreserveNewest" Link="assets\spritesheet.png" />
    <None Update="assets\fondo_espacio.jpg" CopyToOutputDirectory="PreserveNewest" Link="assets\fondo_espacio.jpg" />
    <None Update="config.conf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="puntajes.dat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>


